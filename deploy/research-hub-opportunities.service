# Refreshes the Grants.gov funding calls (only the opportunity tables; awards are untouched).
# Installed and enabled by the steps in docs/deploy.md; triggered daily by research-hub-opportunities.timer.
[Unit]
Description=Research Hub: refresh Grants.gov funding calls
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/research-hub/backend
# The same settings file as research-hub-api.service (DATABASE_URL and the rest); backend/.env, if present, is
# read too, but real environment variables win.
EnvironmentFile=-/etc/research-hub.env
ExecStart=/root/.local/bin/uv run --no-sync python -m ingest.grants_gov
TimeoutStartSec=30min
Nice=10
