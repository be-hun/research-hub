# Copy to backend/.env (it is read automatically on startup). Never commit the real .env.
HUB_DB=data/hub.db
CORS_ORIGINS=http://localhost:3000

# Assistant. Choose a provider and set its key only in an untracked backend/.env.
AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_TIMEOUT_SECONDS=30

# To use Gemini instead: AI_PROVIDER=gemini, GEMINI_API_KEY=..., AI_MODEL=gemini-3.5-flash-lite
