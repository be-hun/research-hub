# Copy to backend/.env (it is read automatically on startup). Never commit the real .env.
HUB_DB=data/hub.db
CORS_ORIGINS=http://localhost:3000

# Assistant. Default provider is Gemini: get a key at https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=
# AI_MODEL=gemini-3.5-flash-lite   # or gemini-3.8-flash for stronger answers

# To use Claude instead: AI_PROVIDER=anthropic, ANTHROPIC_API_KEY=..., AI_MODEL=claude-opus-5-5
