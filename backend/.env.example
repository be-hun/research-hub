# Copy to backend/.env (it is read automatically on startup). Never commit the real .env.
# Postgres. Production: Supabase > Project > Connect > "Session pooler" URI (the direct one is IPv6-only).
# Local development: brew install postgresql@17 && createdb research_hub
DATABASE_URL=postgresql:///research_hub
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DB_POOL_SIZE=5        # connections per API process; keep the total under the pooler's client limit
CORS_ORIGINS=http://localhost:3000

# Assistant. Choose a provider and set its key only in an untracked backend/.env.
AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5
# AI_TIMEOUT_SECONDS=30

# To use Gemini instead: AI_PROVIDER=gemini, GEMINI_API_KEY=..., AI_MODEL=gemini-3.5-flash-lite
